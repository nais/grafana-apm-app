{
  "type": "grafana",
  "name": "New frontend exceptions – my-svc (prod-gcp)",
  "condition": "C",
  "evaluateFor": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "queries": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "datasourceUid": "mimir-prod-gcp",
      "model": {
        "expr": "sum by (service_namespace, service_name, k8s_cluster_name, hash) (\n  sum_over_time(loki:apm:exception_sessions:count1m{service_namespace=\"team-a\", service_name=\"my-svc\", k8s_cluster_name=\"prod-gcp\"}[30m])\n)\nunless on (service_namespace, service_name, k8s_cluster_name, hash)\nsum by (service_namespace, service_name, k8s_cluster_name, hash) (\n  count_over_time(loki:apm:exception_sessions:count1m{service_namespace=\"team-a\", service_name=\"my-svc\", k8s_cluster_name=\"prod-gcp\"}[7d] offset 30m)\n)",
        "instant": true,
        "range": false,
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "datasourceUid": "__expr__",
      "model": {
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "queryType": "",
      "datasourceUid": "__expr__",
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                0
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "C"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "expression": "B",
        "refId": "C",
        "type": "threshold"
      }
    }
  ],
  "annotations": [
    {
      "key": "summary",
      "value": "Frontend exception {{ $labels.hash }} in my-svc was not seen in the previous 7 days (approximate stateless detection: issues older than the 7d lookback re-fire as new, and resolved-issue regressions do not fire)"
    },
    {
      "key": "nais_apm_url",
      "value": "/a/nais-apm-app/services/team-a/my-svc?environment=prod-gcp\u0026exceptionHash={{ $labels.hash }}\u0026tab=issues"
    }
  ],
  "labels": [
    {
      "key": "namespace",
      "value": "team-a"
    },
    {
      "key": "team",
      "value": "team-a"
    },
    {
      "key": "env",
      "value": "prod-gcp"
    },
    {
      "key": "service",
      "value": "my-svc"
    },
    {
      "key": "source",
      "value": "nais-apm"
    },
    {
      "key": "severity",
      "value": "info"
    }
  ]
}
