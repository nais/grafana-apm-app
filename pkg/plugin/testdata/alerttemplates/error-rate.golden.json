{
  "type": "grafana",
  "name": "Error rate above 5% – my-svc (prod-gcp)",
  "condition": "C",
  "evaluateFor": "5m",
  "queries": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "datasourceUid": "mimir-prod-gcp",
      "model": {
        "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"my-svc\", service_namespace=\"team-a\", k8s_cluster_name=\"prod-gcp\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_span_metrics_calls_total{service_name=\"my-svc\", service_namespace=\"team-a\", k8s_cluster_name=\"prod-gcp\"}[5m]))",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "datasourceUid": "__expr__",
      "model": {
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "queryType": "",
      "datasourceUid": "__expr__",
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                0.05
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "C"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "datasource": {
          "type": "__expr__",
          "uid": "__expr__"
        },
        "expression": "B",
        "refId": "C",
        "type": "threshold"
      }
    }
  ],
  "annotations": [
    {
      "key": "summary",
      "value": "More than 5% of requests to my-svc are failing (5m window)"
    },
    {
      "key": "nais_apm_url",
      "value": "/a/nais-apm-app/services/team-a/my-svc?environment=prod-gcp"
    }
  ],
  "labels": [
    {
      "key": "namespace",
      "value": "team-a"
    },
    {
      "key": "service",
      "value": "my-svc"
    },
    {
      "key": "source",
      "value": "nais-apm"
    }
  ]
}
