  },
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "postbuild": "node scripts/check-bundle-size.js",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "seed": "node --experimental-strip-types scripts/seed/cli.ts",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest --rootUrls https://grafana.nav.cloud.nais.io/,https://grafana.dev-nais.cloud.nais.io/,https://monitoring.nais.io",
    "validate": "bash scripts/validate-plugin.sh"
  },
