{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Nais APM",
  "id": "nais-apm-app",
  "backend": true,
  "executable": "gpx_apm",
  "info": {
    "keywords": ["app", "observability", "apm", "otel", "opentelemetry"],
    "description": "Application Performance Monitoring powered by OpenTelemetry data from Mimir, Loki, and Tempo",
    "author": {
      "name": "Nais",
      "url": "https://nais.io"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Service Inventory",
        "path": "img/screenshot-service-inventory.png"
      },
      {
        "name": "Service Overview",
        "path": "img/screenshot-service-overview.png"
      },
      {
        "name": "Backend",
        "path": "img/screenshot-service-server.png"
      },
      {
        "name": "Frontend Observability",
        "path": "img/screenshot-service-frontend.png"
      }
    ],
    "links": [
      { "name": "GitHub", "url": "https://github.com/nais/grafana-apm-app" },
      { "name": "Issues", "url": "https://github.com/nais/grafana-apm-app/issues" },
      { "name": "License", "url": "https://github.com/nais/grafana-apm-app/blob/main/LICENSE" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Services",
      "path": "/a/nais-apm-app/services",
      "addToNav": true,
      "defaultNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Jobs",
      "path": "/a/nais-apm-app/jobs",
      "icon": "calendar-alt",
      "addToNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "My Apps",
      "path": "/a/nais-apm-app/favorites",
      "icon": "favorite",
      "addToNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Ops Status",
      "path": "/a/nais-apm-app/ops",
      "icon": "monitor",
      "addToNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Service Map",
      "path": "/a/nais-apm-app/service-map",
      "icon": "sitemap",
      "addToNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Dependencies",
      "path": "/a/nais-apm-app/dependencies",
      "addToNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/nais-apm-app",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.0.0",
    "plugins": []
  },
  "iam": {
    "permissions": [
      { "action": "datasources:query", "scope": "datasources:*" },
      { "action": "annotations:read", "scope": "annotations:*" },
      { "action": "annotations:create", "scope": "annotations:*" },
      { "action": "annotations:write", "scope": "annotations:*" }
    ]
  },
  "extensions": {
    "addedLinks": [
      {
        "targets": ["grafana/commandpalette/action"],
        "title": "APM: Services",
        "description": "View all services and their health"
      },
      {
        "targets": ["grafana/commandpalette/action"],
        "title": "APM: My Apps",
        "description": "View your favorite services"
      }
    ]
  }
}
