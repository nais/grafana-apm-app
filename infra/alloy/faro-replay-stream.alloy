// ============================================================================
// FUTURE — Milestone M5 (target v0.19). DO NOT APPLY YET.
//
// This file is a design sketch for nais/grafana-apm-app#58 ("Session replay:
// error-triggered rrweb recording + self-hosted player"), Phase 1 pipeline
// change. It depends on:
//   - @nais/apm (#59) shipping its `ReplayInstrumentation` module, which does
//     not exist yet.
//   - A go/no-go decision from the #58 Phase 0 spike (real payload sizes and
//     rates measured on a pilot NAV app) — the roadmap explicitly gates this
//     on that spike's numbers, not on this config being ready.
//   - Legal/personvernombud sign-off before ANY citizen-facing app enables
//     replay (internal apps behind Azure AD only, first).
//
// TARGET REPO (once Phase 0 gives a go): the platform's Alloy config repo,
// same place as `faro-receiver-sourcemaps.alloy`, plus the Loki config repo
// for the `compactor`/`limits_config` snippet at the bottom of this file.
// ============================================================================

// --- Alloy: loki.process stage rewriting replay events onto their own label ---
//
// Per #58: "a loki.process stage matches event_name=faro.session_recording.*
// and rewrites the stream label to kind="replay"". This keeps replay bulk out
// of every existing kind="event" query and is what makes the 7-day
// retention_stream override below possible (retention_stream matches on
// stream labels, so replay volume MUST carry its own label, not just a log
// line field).
//
// CAUTION: the exact stage names/nesting below are a design sketch, not a
// verbatim quote from Alloy docs (unlike the faro.receiver sourcemaps block
// in `faro-receiver-sourcemaps.alloy`, which #60 quotes directly). Verify
// against the current `loki.process` / `stage.match` reference
// (https://grafana.com/docs/alloy/latest/reference/components/loki/loki.process/)
// before applying — Alloy's stage set has changed across versions.
loki.process "faro_replay_relabel" {
  forward_to = [loki.write.default.receiver] // wire to the tenant's existing loki.write

  // The Faro receiver flattens session-recording events to logfmt lines
  // shaped like: kind=event event_name=faro.session_recording.chunk ...
  // (verified against Alloy's payload.go in #58's research). `event_name` is
  // a line field, not yet a stream label, so we match on line content here
  // and only THEN promote a new label.
  stage.match {
    selector = `{app_name=~".+"} |= "event_name=faro.session_recording"`

    // Adds kind="replay" as a stream label for lines matching the selector
    // above. app_name/env stay as the only other labels — session_id stays
    // a logfmt field, deliberately kept out of labels to avoid cardinality
    // blowup (one stream per session would be catastrophic at NAV's scale).
    stage.static_labels {
      values = {
        kind = "replay",
      }
    }
  }
}

// ----------------------------------------------------------------------------
// Loki: compactor retention_stream override for the new kind="replay" stream
//
// This is Loki server config (loki.yaml / the tenant's Loki Helm values),
// NOT Alloy config — kept in this file for visibility since the two changes
// ship together, but it belongs in the Loki config repo, not the Alloy one.
//
// Requires `compactor.retention_enabled: true` tenant-wide (retention_stream
// overrides only take effect when retention is enabled at all).
// ----------------------------------------------------------------------------
//
// compactor:
//   retention_enabled: true
//
// limits_config:
//   # Existing tenant-wide retention_period is unchanged; this override
//   # applies ONLY to streams matching the selector below.
//   retention_stream:
//     - selector: '{kind="replay"}'
//       priority: 1
//       # 7 days, mirroring Grafana Cloud Frontend Observability's default
//       # replay retention (#58 research) — replay is privacy-sensitive
//       # (masked, but still session recordings) and far bulkier than a
//       # normal Faro event stream, so it gets a deliberately short,
//       # separate retention rather than inheriting the tenant default.
//       period: 7d
//
// ----------------------------------------------------------------------------
// Reminder of what this pipeline exists to carry (see #58 for full design):
// chunked, gzip+base64-encoded rrweb segments, ≤96KB per Loki line, pushed as
// faro.session_recording.chunk events with session_id/chunk_seq/enc/first_ts/
// last_ts/count fields — all comfortably under Loki's 256KB default
// max_line_size with ZERO Loki limits config changes required. Do not raise
// max_line_size for this in production; that was a Phase-0-spike-only,
// temporary measure per #58 and is not part of this (future) production
// config.
// ============================================================================
